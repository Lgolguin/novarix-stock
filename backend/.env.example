# SOLO TEST. No usar la cuenta vendedora real ni fondos reales.
STOCK_MP_MODE=test
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_TEST_SELLER_ID=
MERCADOPAGO_TEST_BUYER_ID=
# Precio oficial mensual en ARS; no hay conversión automática.
STOCK_PRO_MONTHLY_ARS=49999.00
# Clave Ed25519 privada (32 bytes base64), generada con backend.generate_keys.
STOCK_LICENSE_PRIVATE_KEY=
# HTTPS público temporal que reenvía al backend local para la prueba.
STOCK_WEBHOOK_URL=https://REEMPLAZAR/webhooks/mercadopago
STOCK_BACK_URL=https://REEMPLAZAR/retorno
# Base separada del inventario. Ejemplo relativo a D:\NOVARIX STOCK:
STOCK_BACKEND_DB=backend/data/licenses.db
